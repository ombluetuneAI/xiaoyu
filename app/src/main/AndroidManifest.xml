<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".XiaoyuApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xiaoyu">

        <activity
            android:name=".ui.LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.Xiaoyu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.VoiceHomeActivity" android:exported="false" />
        <activity android:name=".ui.onboarding.OnboardingActivity" android:exported="false" />
        <activity android:name=".ui.activation.ActivationActivity" android:exported="false" />
        <activity android:name=".ui.settings.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.settings.TxbSettingsActivity" android:exported="false" />
        <activity android:name=".ui.settings.BindDetailActivity" android:exported="false" />
        <activity android:name=".ui.settings.BackgroundCheckActivity" android:exported="false" />
        <activity android:name=".ui.settings.AdapterAppsActivity" android:exported="false" />
        <activity android:name=".ui.media.PlayerActivity" android:exported="false" />
        <activity android:name=".ui.media.QueueActivity" android:exported="false" />

        <service
            android:name="com.xiaoyu.service.XiaoyuAssistantService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <receiver
            android:name=".debug.DebugVoiceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.xiaoyu.debug.WAKE" />
                <action android:name="com.xiaoyu.debug.END_SESSION" />
                <action android:name="com.xiaoyu.debug.CONNECT_VOICE" />
                <action android:name="com.xiaoyu.debug.SIMULATE_KWS" />
                <action android:name="com.xiaoyu.debug.PLAY_WAKE_TTS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".boot.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".link.XiaoyuLinkResultReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.xiaoyu.action.COMMAND_RESULT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.xiaoyu.service.ServiceRestartReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.xiaoyu.action.SERVICE_RESTART" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.xiaoyu.service.MediaControlReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.xiaoyu.action.MEDIA_PREVIOUS" />
                <action android:name="com.xiaoyu.action.MEDIA_TOGGLE" />
                <action android:name="com.xiaoyu.action.MEDIA_NEXT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
