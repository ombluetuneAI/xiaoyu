<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xiaoyu_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_debug_title"
            android:textColor="@color/xiaoyu_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_debug_hint"
            android:textColor="@color/xiaoyu_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/rowKws"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:text="@string/kws_settings_row"
            android:textColor="@color/xiaoyu_text" />

        <TextView
            android:id="@+id/rowStartService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/settings_debug_start_service"
            android:textColor="@color/xiaoyu_text" />

        <TextView
            android:id="@+id/rowTestPlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/settings_debug_test_play"
            android:textColor="@color/xiaoyu_text" />

        <TextView
            android:id="@+id/rowPlayMusic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/settings_debug_play_music"
            android:textColor="@color/xiaoyu_primary" />

        <TextView
            android:id="@+id/rowAdapters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/settings_debug_adapters"
            android:textColor="@color/xiaoyu_text" />
    </LinearLayout>
</ScrollView>
