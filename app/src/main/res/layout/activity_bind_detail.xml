<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/xiaoyu_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/bindStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/xiaoyu_primary" android:textSize="18sp"/>
        <TextView android:id="@+id/bindMac" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="@color/xiaoyu_muted"/>
        <TextView android:id="@+id/wsStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="@color/xiaoyu_text" android:textSize="14sp"/>
        <TextView android:id="@+id/activationCode" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="@color/xiaoyu_warn" android:visibility="gone"/>
        <Button android:id="@+id/btnOpenConsole" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="打开智控台" android:visibility="gone"/>
        <Button android:id="@+id/btnRefresh" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="重新检查"/>
    </LinearLayout>
</ScrollView>
