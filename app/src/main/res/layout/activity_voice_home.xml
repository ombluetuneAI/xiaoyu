<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xiaoyu_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/keepaliveBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/xiaoyu_warn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/keepalive_banner"
            android:textColor="@color/xiaoyu_bg"
            android:textSize="13sp"
            android:visibility="gone" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipBind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/xiaoyu_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipWs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/xiaoyu_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:text="@string/settings"
                android:textColor="@color/xiaoyu_muted"
                android:textSize="14sp" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statusBall"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@drawable/bg_status_ball"
                android:gravity="center"
                android:text="@string/state_idle"
                android:textColor="@color/xiaoyu_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/wake_hint"
                android:textColor="@color/xiaoyu_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnWake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/xiaoyu_primary"
            android:gravity="center"
            android:padding="18dp"
            android:text="@string/voice_home_wake_tap"
            android:textColor="@color/xiaoyu_bg"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/miniPlayerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/xiaoyu_surface"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/miniPlayerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/xiaoyu_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/xiaoyu_muted"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/bottomRecoveryBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/xiaoyu_surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/xiaoyu_warn"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/unboundOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60f1419"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/unbound_title"
            android:textColor="@color/xiaoyu_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/unbound_desc"
            android:textColor="@color/xiaoyu_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnGoBind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/xiaoyu_primary"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/go_bind"
            android:textColor="@color/xiaoyu_bg"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
