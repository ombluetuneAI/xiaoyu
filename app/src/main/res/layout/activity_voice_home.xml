<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xiaoyu_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_home_title"
            android:textColor="@color/xiaoyu_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wake_hint"
            android:textColor="@color/xiaoyu_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/xiaoyu_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="状态"
                android:textColor="@color/xiaoyu_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/bindStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/xiaoyu_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/voiceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/xiaoyu_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/sessionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/xiaoyu_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/nowPlayingStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/xiaoyu_primary"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnWake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/xiaoyu_surface"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/voice_home_wake"
            android:textColor="@color/xiaoyu_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/xiaoyu_surface"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/voice_home_play"
            android:textColor="@color/xiaoyu_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/xiaoyu_surface"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/settings"
            android:textColor="@color/xiaoyu_muted"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
