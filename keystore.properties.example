# Release 签名配置模板（请复制为 keystore.properties 并填入真实值；keystore.properties 已被 .gitignore 忽略，切勿提交）
#
# 生成 keystore：
#   keytool -genkeypair -v -keystore keystore/xiaoyu-release.jks -storetype PKCS12 \
#     -alias xiaoyu -keyalg RSA -keysize 2048 -validity 10000
#
# 说明：storeFile 为相对 app 模块或工程根的路径（本工程按工程根解析）。
# 若缺少本文件或 keystore，release 构建会回退为“未签名”，需手动签名后才能安装。

storeFile=keystore/xiaoyu-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=xiaoyu
keyPassword=YOUR_KEY_PASSWORD
